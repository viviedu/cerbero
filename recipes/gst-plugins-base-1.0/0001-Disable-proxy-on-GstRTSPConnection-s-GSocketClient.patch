From 5496cc208240a408aa940db5200a7d8734bdf5ce Mon Sep 17 00:00:00 2001
From: Mahoda Ratnayaka <mahodar@vivi.io>
Date: Tue, 10 Jun 2025 15:19:09 +1000
Subject: [PATCH 1/2] Disable proxy on GstRTSPConnection's GSocketClient

---
 .../gst-plugins-base/gst-libs/gst/rtsp/gstrtspconnection.c      | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/subprojects/gst-plugins-base/gst-libs/gst/rtsp/gstrtspconnection.c b/subprojects/gst-plugins-base/gst-libs/gst/rtsp/gstrtspconnection.c
index 40ca87ace3..6993e70652 100644
--- a/subprojects/gst-plugins-base/gst-libs/gst/rtsp/gstrtspconnection.c
+++ b/subprojects/gst-plugins-base/gst-libs/gst/rtsp/gstrtspconnection.c
@@ -424,6 +424,8 @@ gst_rtsp_connection_create (const GstRTSPUrl * url, GstRTSPConnection ** conn)
   g_mutex_init (&newconn->cancellable_mutex);
   newconn->client = g_socket_client_new ();
 
+  g_socket_client_set_enable_proxy(newconn->client, FALSE);
+
   if (url->transports & GST_RTSP_LOWER_TRANS_TLS)
     g_socket_client_set_tls (newconn->client, TRUE);
 
