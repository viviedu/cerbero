From bd06166d06e3f82a7632edda23c23dc0e20bce98 Mon Sep 17 00:00:00 2001
From: Berke Batmaz <berke.batmaz@gmail.com>
Date: Wed, 28 Aug 2024 13:40:14 +1000
Subject: [PATCH] Disable proxy on GstRTSPConnection's GSocketClient

---
 gst-libs/gst/rtsp/gstrtspconnection.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/gst-libs/gst/rtsp/gstrtspconnection.c b/gst-libs/gst/rtsp/gstrtspconnection.c
index dbcaa46..2d7b276 100644
--- a/gst-libs/gst/rtsp/gstrtspconnection.c
+++ b/gst-libs/gst/rtsp/gstrtspconnection.c
@@ -395,6 +395,8 @@ gst_rtsp_connection_create (const GstRTSPUrl * url, GstRTSPConnection ** conn)
   g_mutex_init (&newconn->cancellable_mutex);
   newconn->client = g_socket_client_new ();

+  g_socket_client_set_enable_proxy(newconn->client, FALSE);
+
   if (url->transports & GST_RTSP_LOWER_TRANS_TLS)
     g_socket_client_set_tls (newconn->client, TRUE);

--
2.17.1

