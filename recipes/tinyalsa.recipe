# -*- Mode: Python -*- vi:si:et:sw=4:sts=4:ts=4:syntax=python

import os
import shutil

class Recipe(recipe.Recipe):
    """
    Sets up build based on the tinyalsa library.
    """
    name = 'tinyalsa'
    version = '0.1'
    licenses = [License.Apachev2]
    btype = BuildType.MAKEFILE
    remotes = {'origin': 'https://github.com/tinyalsa/tinyalsa'}
    commit = '1.1.1'
    library_type = LibraryType.STATIC

    patches = [
        'tinyalsa/0001-fix-defines.patch',
        'tinyalsa/0002-build-lib-only.patch',
        'tinyalsa/0003-fix-makefile.patch',
    ]

    files_devel = [ 'include/tinyalsa/', '%(libdir)s/pkgconfig/tinyalsa.pc' ]

    files_libs = [ 'libtinyalsa' ]

    def prepare(self):
        if self.config.target_platform != Platform.LINUX and self.config.target_platform != Platform.ANDROID:
            raise InvalidRecipeError(self, "Invalid platform")

    async def install(self):
        include_path = os.path.join(self.config.prefix, 'include', 'tinyalsa')
        library_path = self.config.libdir

        tinyalsa_header = os.path.join(self.build_dir, 'include', 'tinyalsa', 'asoundlib.h')
        tinyalsa_mixer = os.path.join(self.build_dir, 'include', 'tinyalsa', 'mixer.h')
        tinyalsa_pcm = os.path.join(self.build_dir, 'include', 'tinyalsa', 'pcm.h')
        tinyalsa_version = os.path.join(self.build_dir, 'include', 'tinyalsa', 'version.h')
        tinyalsa_lib = os.path.join(self.build_dir, 'src', 'libtinyalsa.a')
        tinyalsa_lib_so = os.path.join(self.build_dir, 'src', 'libtinyalsa.so')

        if not os.path.exists(include_path):
            os.makedirs(include_path)

        shutil.copy(tinyalsa_header, include_path)
        shutil.copy(tinyalsa_mixer, include_path)
        shutil.copy(tinyalsa_pcm, include_path)
        shutil.copy(tinyalsa_version, include_path)
        shutil.copy(tinyalsa_lib, library_path)
        shutil.copy(tinyalsa_lib_so, library_path)

        # gst-plugins-bad >= 1.18 locates tinyalsa via pkg-config only, so
        # install a tinyalsa.pc by hand (the Makefile build doesn't ship one).
        # Version must satisfy the >= 1.1.0 check; the source is git tag 1.1.1.
        pkgconfig_path = os.path.join(library_path, 'pkgconfig')
        if not os.path.exists(pkgconfig_path):
            os.makedirs(pkgconfig_path)
        with open(os.path.join(pkgconfig_path, 'tinyalsa.pc'), 'w') as f:
            f.write('prefix={}\n'
                    'libdir={}\n'
                    'includedir=${{prefix}}/include\n'
                    '\n'
                    'Name: tinyalsa\n'
                    'Description: TinyALSA library\n'
                    'Version: 1.1.1\n'
                    'Libs: -L${{libdir}} -ltinyalsa\n'
                    'Cflags: -I${{includedir}}\n'.format(
                        self.config.prefix, library_path))
