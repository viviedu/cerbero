# i.MX6 (ARMv7 hard-float, Debian bookworm, glibc 2.36) cross build
import os
from cerbero.config import Platform, Architecture, Distro, DistroVersion

target_platform = Platform.LINUX
target_distro = Distro.DEBIAN
target_arch = Architecture.ARMv7
host = 'arm-linux-gnueabihf'
target_arch_flags = '-mfpu=neon -mfloat-abi=hard'
allow_system_libs = False
# cerbero skips glib-tools for Linux targets; needed here as no system glib-mkenums is used
extra_build_tools = ['glib-tools']
variants.override(['noalsa', 'nox11', 'nopulse', 'nocdparanoia',
                   'nov4l2', 'notestspackage', 'nopython', 'norust', 'nogi', 'imx'])
